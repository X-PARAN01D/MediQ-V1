# --- Firebase web config (paste from Firebase console > Project settings) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Gemini (optional, client key ONLY for local dev) ---
# Production: never ship a Gemini key in the client. Set it as a function
# secret instead: `firebase functions:secrets:set GEMINI_API_KEY`
VITE_GEMINI_API_KEY=

# When all VITE_FIREBASE_* values are set, the app uses Firebase.
# Otherwise it runs in demo mode (localStorage) with a visible demo badge.
